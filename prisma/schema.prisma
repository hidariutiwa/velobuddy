generator client {
    provider = "prisma-client"
    output   = "../src/lib/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Prefectures {
    id            Int           @id @default(autoincrement())
    name          String
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt
    userAddresses UserAddress[]
}

model User {
    id                 Int                 @id @default(autoincrement())
    googleId           String?             @unique
    nickname           String
    email              String              @unique
    birthday           DateTime?
    sex                Int?
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    userFavoritePlaces UserFavoritePlace[]
    activities         Activity[]
    monthlySummaries   MonthlyActivitySummary[]

    // Strava OAuth
    stravaAthleteId    Int?     @unique
    stravaAccessToken  String?
    stravaRefreshToken String?
    stravaTokenExpiresAt Int? // unix timestamp
}

model UserAddress {
    id            Int         @id @default(autoincrement())
    name          String?
    addressType   Int
    postalCode    String
    prefecturesId Int
    prefectures   Prefectures @relation(fields: [prefecturesId], references: [id])
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
}

model PlaceCategory {
    id        Int      @id @default(autoincrement())
    name      String   @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    places    Place[]
}

model Place {
    id                 Int                 @id @default(autoincrement())
    googlePlaceId      String              @unique
    name               String
    latitude           Float?
    longitude          Float?
    address            String?
    imageUrl           String?
    priceLevel         String?
    openingHours       String?
    createdAt          DateTime            @default(now())
    updatedAt          DateTime            @updatedAt
    categories         PlaceCategory[]
    userFavoritePlaces UserFavoritePlace[]
}

model UserFavoritePlace {
    id        Int      @id @default(autoincrement())
    userId    Int
    user      User     @relation(fields: [userId], references: [id])
    placeId   Int
    place     Place    @relation(fields: [placeId], references: [id])
    visited   Boolean  @default(false)
    memo      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Activity {
    id        Int  @id @default(autoincrement())
    userId    Int
    user      User @relation(fields: [userId], references: [id])

    // Strava identification
    stravaId   BigInt?  @unique
    externalId String? // e.g. "Cycle-20260329-2128-85940.fit"
    source     String   @default("manual") // "strava" or "manual"

    // Basic info
    name      String  @default("")
    sportType String  @default("Ride") // "Ride", "EBikeRide", "VirtualRide"

    // Time
    startDate   DateTime? // UTC start time
    timezone    String? // e.g. "(GMT+09:00) Asia/Tokyo"
    movingTime  Int // seconds of actual movement
    elapsedTime Int // total seconds including stops

    // Distance & elevation (meters)
    distance           Float // meters
    totalElevationGain Float  @default(0) // meters
    elevHigh           Float? // highest point (meters)
    elevLow            Float? // lowest point (meters)

    // Speed (m/s)
    averageSpeed Float // m/s
    maxSpeed     Float // m/s

    // Power (estimated or device)
    averageWatts Float?
    deviceWatts  Boolean @default(false)
    kilojoules   Float?

    // Optional metrics
    averageCadence   Float?
    averageHeartrate Float?
    maxHeartrate     Float?
    hasHeartrate     Boolean @default(false)
    calories         Float?
    averageTemp      Float? // Celsius

    // Map data
    polyline        String? // full polyline (detail)
    summaryPolyline String? // simplified polyline (list)
    startLatlng     Json? // [lat, lng]
    endLatlng       Json? // [lat, lng]

    // Classification flags
    trainer Boolean @default(false)
    commute Boolean @default(false)
    manual  Boolean @default(false)

    // Metadata
    gearId String? // Strava gear ID
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    splits ActivitySplit[]
}

model ActivitySplit {
    id         Int      @id @default(autoincrement())
    activityId Int
    activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

    split               Int // 1-based split index
    distance            Float // meters
    elapsedTime         Int // seconds
    movingTime          Int // seconds
    elevationDifference Float // meters (can be negative)
    averageSpeed        Float // m/s
    paceZone            Int   @default(0)

    @@unique([activityId, split])
}

model MonthlyActivitySummary {
    id              Int      @id @default(autoincrement())
    userId          Int
    user            User     @relation(fields: [userId], references: [id])
    year            Int
    month           Int // 1-12
    totalDistance    Float // meters
    totalMovingTime Int // seconds
    activityCount   Int
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt

    @@unique([userId, year, month])
}
